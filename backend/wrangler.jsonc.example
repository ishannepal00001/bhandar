{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bhandar-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // ../schemas has no node_modules of its own; resolve its zod import from backend's.
  "alias": { "zod": "./node_modules/zod" },

  // wrangler dev regenerates worker-configuration.d.ts whenever this file changes.
  "dev": { "generate_types": true },

  // Every tunable value, read through the Worker bindings (`import { env } from 'cloudflare:workers'` or c.env).
  "vars": {
    "OTP_LENGTH": 6,
    "OTP_TTL_MINUTES": 10,
    // Wrong codes a live code survives; after that it's deleted and a new one needs the password again.
    "OTP_MAX_ATTEMPTS": 5,
    "OTP_MAIL_SUBJECT": "Your Bhandar login code",
    // Who gets the login code. Empty sends it to the seeded user's email only.
    "OTP_RECIPIENTS": [],
    "PASSWORD_MIN_LENGTH": 8,
    "PASSWORD_SALT_BYTES": 16,
    // PBKDF2-SHA256 rounds for new password hashes (stored hashes keep their own count). Workers allows at most 100000,
    // but Workers Free gives a request about 10ms of CPU and 20000 takes about 5ms.
    "PASSWORD_HASH_ITERATIONS": 20000,
    "JWT_ALGORITHM": "HS256",
    "JWT_TTL_DAYS": 7,
    "COOKIE_NAME": "bhandar_token",
    "COOKIE_SECURE": true,
    // The frontend is on another site, so the cookie must be SameSite None (which browsers only accept with Secure).
    "COOKIE_SAME_SITE": "None",
    // The origins allowed by CORS and CSRF checks: the deployed frontend's URL (no trailing slash) and the Vite dev server.
    "FRONTEND_ORIGINS": ["https://<frontend>.pages.dev", "http://localhost:5173"],
    "SMTP_HOST": "",
    "SMTP_PORT": 465,
    "SMTP_USER": "",
    "MAIL_FROM": "",
    "B2_BUCKET": "bhandar.bucket",
    "B2_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "B2_REGION": "us-east-005",
    "STORAGE_URL_TTL_SECONDS": 3600,
    // The fetchr download service, the client id it knows us by, and how the DownloadTracker polls it. The timeout covers
    // fetchr waking from sleep (Render's free tier takes 30-60s).
    "DOWNLOADER_URL": "http://127.0.0.1:8000",
    "DOWNLOADER_CLIENT_ID": "my-client",
    "DOWNLOADER_TIMEOUT_SECONDS": 60,
    "DOWNLOAD_POLL_SECONDS": 8,
    "DOWNLOAD_MAX_POLL_FAILURES": 15,
    "DOWNLOAD_TRACKER_NAME": "downloads",
    "SSE_HEARTBEAT_SECONDS": 25,
    // Most downloads queued at once; the tracker also polls at most this many per alarm. Keep it under 50, the
    // subrequests one Workers Free invocation may make.
    "DOWNLOAD_MAX_QUEUED": 10,
    // Added to the name a finished video is saved under (fetchr merges downloads into mp4).
    "DOWNLOAD_FILE_EXTENSION": ".mp4",
    // Clip exports, rendered by fetchr into one MP4. Most exports queued at once, polled with the downloads on the same
    // alarm, so DOWNLOAD_MAX_QUEUED + EXPORT_MAX_QUEUED must stay under 50. The clip limits must not be looser than
    // fetchr's (20 clips, 0.5s per clip, FETCHR_RENDER_MAX_SECONDS in total) or fetchr refuses the render.
    "EXPORT_MAX_QUEUED": 3,
    "EXPORT_MAX_CLIPS": 20,
    "EXPORT_MIN_CLIP_SECONDS": 0.5,
    "EXPORT_MAX_SECONDS": 600,
    // Added after the source video's title in the name an export is saved under, before DOWNLOAD_FILE_EXTENSION.
    "EXPORT_FILE_SUFFIX": " (clip)",
    // Uploaded videos to export clips from. The browser sends the file straight to B2 with a signed link that lasts
    // UPLOAD_URL_TTL_SECONDS; the Worker never sees the bytes. An upload is deleted with the last export made from it,
    // and one that was never exported is deleted by the daily cleanup once it's UPLOAD_STALE_HOURS old.
    "UPLOAD_MAX_BYTES": 2147483648,
    "UPLOAD_URL_TTL_SECONDS": 3600,
    "UPLOAD_STALE_HOURS": 24,
    // How many finished downloads GET /api/v1/dashboard returns.
    "DASHBOARD_RECENT_LIMIT": 6,
    "DOWNLOAD_ALLOWED_HOSTS": ["facebook.com", "www.facebook.com", "m.facebook.com", "web.facebook.com", "fb.watch"],
    // Secrets (listed in package.json's deploy script). Copy this file to wrangler.jsonc (gitignored) and fill them in.
    "JWT_SECRET": "",
    "SMTP_PASS": "",
    "B2_KEY_ID": "",
    "B2_APP_KEY": "",
    "DOWNLOADER_SEED_CODE": ""
  },

  "d1_databases": [
    {
      "binding": "BHANDAR_DB",
      "database_name": "bhandardb",
      // Replace with the id printed by `wrangler d1 create bhandardb`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // One DownloadTracker instance (named DOWNLOAD_TRACKER_NAME) holds fetchr's rolling code, polls fetchr for downloads and
  // exports, and serves both SSE streams.
  "durable_objects": {
    "bindings": [{ "name": "DOWNLOAD_TRACKER", "class_name": "DownloadTracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DownloadTracker"] }],

  // Runs scheduled() daily: deletes uploads that were never exported (UPLOAD_STALE_HOURS).
  "triggers": { "crons": ["0 3 * * *"] },

  // IP-keyed limits. period must be 10 or 60 seconds; counts are per Cloudflare location and approximate.
  "ratelimits": [
    { "name": "SEND_OTP_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 10 } }
  ]
}
