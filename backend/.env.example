# Server
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
MAX_CONCURRENT=2

# Backblaze B2 (S3-compatible API)
# Create an application key in the B2 dashboard with access to the bucket below.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# Shown on the bucket page as "Endpoint", e.g. s3.us-west-004.backblazeb2.com
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
