-- Creates the login user. Copy to 0002_seed_user.sql (gitignored), fill in the three values, then:
--   bun run db:migrate:local   (or db:migrate:remote)
--
-- password is "pbkdf2_sha256$<iterations>$<hex>": PBKDF2-HMAC-SHA256 of the password, salted with the salt's bytes,
-- matching hashPassword in src/modules/auth/utils.ts. Use PASSWORD_HASH_ITERATIONS (20000) as the iterations. This
-- prompts for the password, so it never lands in shell history, and prints both values:
--   python3 -c 'import getpass,hashlib,os; n=20000; s=os.urandom(16).hex(); p=getpass.getpass().encode(); print("salt:", s); print("password: pbkdf2_sha256$%d$%s" % (n, hashlib.pbkdf2_hmac("sha256", p, bytes.fromhex(s), n).hex()))'
-- The password must have at least PASSWORD_MIN_LENGTH (8) characters with an uppercase letter,
-- a lowercase letter, a number and a symbol.
--
-- A migration runs once. To change the password later, add a new migration with the same statement, or run this file
-- again with `wrangler d1 execute bhandardb --local --file migrations/0002_seed_user.sql` (--remote for production).
INSERT INTO users (name, email, password, password_salt)
VALUES ('Santosh', '<email>', '<password>', '<salt hex>')
ON CONFLICT(name) DO UPDATE SET
  email = excluded.email,
  password = excluded.password,
  password_salt = excluded.password_salt;
