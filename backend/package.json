{
  "name": "bhandar-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply bhandardb --local",
    "db:migrate:remote": "wrangler d1 migrations apply bhandardb --remote",
    "seed:local": "bun --preload ./scripts/workers-env.ts scripts/seed.ts --local",
    "seed:remote": "bun --preload ./scripts/workers-env.ts scripts/seed.ts --remote",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.13",
    "kysely": "^0.28",
    "kysely-d1": "^0.4.0",
    "nodemailer": "^10.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/nodemailer": "^8.0.2",
    "typescript": "~6.0.2",
    "wrangler": "^4.152.0"
  }
}
