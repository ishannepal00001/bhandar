{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bhandar-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // ../schemas has no node_modules of its own; resolve its zod import from backend's.
  "alias": { "zod": "./node_modules/zod" },

  // Non-secret tunables, read in config.ts through process.env.
  "vars": {
    "OTP_TTL_MINUTES": "10",
    "JWT_TTL_DAYS": "7",
    "COOKIE_NAME": "bhandar_token",
    "COOKIE_SECURE": "true",
    "SMTP_HOST": "",
    "SMTP_PORT": "465",
    "SMTP_USER": "",
    "MAIL_FROM": ""
  },

  // Names only. Values go in .dev.vars locally and `wrangler secret put <NAME>` when deployed.
  "secrets": {
    "required": ["JWT_SECRET", "SMTP_PASS"]
  },

  "d1_databases": [
    {
      "binding": "BHANDAR_DB",
      "database_name": "bhandardb",
      // Replace with the id printed by `wrangler d1 create bhandardb`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // IP-keyed limits. period must be 10 or 60 seconds; counts are per Cloudflare location and approximate.
  "ratelimits": [
    { "name": "SEND_OTP_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 10 } }
  ]
}
